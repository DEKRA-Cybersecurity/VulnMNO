<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug-only network policy: permits cleartext HTTP to ANY host so the app
    can reach a backend running on the developer's laptop over the local Wi-Fi
    (e.g. http://192.168.1.42:8000). This file overrides the restrictive
    main/ res/xml/network_security_config.xml only when building the debug
    variant — release builds keep the locked-down config.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
