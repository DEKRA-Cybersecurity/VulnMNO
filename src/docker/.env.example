# VulnMNO Caddy TLS — per-network values.
#
# You normally DON'T edit this. Run `bash ../scripts/up.sh` instead: it
# auto-detects your LAN IP and writes a real .env (gitignored) for you.
#
# Copy to `.env` and set by hand only if you want to pin specific values.
# The defaults below are network-independent (same-machine browser via
# localhost + Android emulator via 10.0.2.2) and need no detection.

# Space-separated hosts/IPs Caddy issues `tls internal` certs for.
VULNMNO_TLS_HOSTS=localhost 127.0.0.1 10.0.2.2

# Cert served to clients that send no SNI (a browser/curl hitting an IP
# literal). Set this to your LAN IP for physical-device / LAN-peer access.
VULNMNO_DEFAULT_SNI=localhost
